mdbook(
    name = "book",
    srcs = glob(["src/**/*.md"]) + [
        "mermaid-init.js",
        ":mermaid_js",
        ":vivado_bitstream_doc",
        ":vivado_block_design_doc",
        ":vivado_debug_probes_doc",
        ":vivado_hw_platform_doc",
        ":vivado_implementation_doc",
        ":vivado_ip_doc",
        ":vivado_packaged_ip_doc",
        ":vivado_project_doc",
        ":vivado_project_export_doc",
        ":vivado_providers_doc",
        ":vivado_simulation_doc",
        ":vivado_synthesis_doc",
        ":vivado_toolchain_doc",
        ":vivado_xdc_library_doc",
    ],
    book = "book.toml",
    plugins = ["@mdbook_mermaid//:mdbook-mermaid"],
    # Windows builds are typically super slow in CI so they're avoided.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

alias(
    name = "docs",
    actual = ":book",
    tags = ["manual"],
)

mdbook_server(
    name = "server",
    book = ":book",
    tags = ["manual"],
)

sh_binary(
    name = "publish_book",
    srcs = ["publish_book.sh"],
    data = [":book"],
    env = {"BOOK_DIR": "$(rootpath :book)"},
    tags = ["manual"],
)
