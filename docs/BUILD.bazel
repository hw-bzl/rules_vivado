load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@io_bazel_stardoc//stardoc:stardoc.bzl", "stardoc")
load("@rules_rust_mdbook//:defs.bzl", "mdbook", "mdbook_server")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# mdbook-mermaid preprocessor (see `book.toml`); fetched by the `mermaid`
# module extension in `extensions.bzl`. `book.toml`'s `additional-js`
# paths are relative to the book root, so the fetched renderer is copied
# next to `book.toml` under the name the config references.
copy_file(
    name = "mermaid_js",
    src = "@mdbook_mermaid//:mermaid.min.js",
    out = "mermaid.min.js",
)

stardoc(
    name = "vivado_toolchain_doc",
    out = "src/vivado_toolchain.md",
    input = "//vivado:toolchain.bzl",
    table_of_contents_template = "@io_bazel_stardoc//stardoc:templates/markdown_tables/table_of_contents.vm",
    tags = ["manual"],
    deps = ["//vivado:bzl_lib"],
)

