set BD_DIR      {{BD_DIR}}
set PART_NUMBER {{PART_NUMBER}}
set MODULE_TOP  {{MODULE_TOP}}
set BD_SCRIPT   {{BD_SCRIPT}}

set IP_REPOS                {{IP_REPOS}}
set IP_CONFIGURED_INSTANCES {{IP_CONFIGURED_INSTANCES}}
set IP_INSTANCES            {{IP_INSTANCES}}

set PRE_HOOKS  {{PRE_HOOKS}}
set POST_HOOKS {{POST_HOOKS}}

# Scratch project in the action's cwd, NOT inside $BD_DIR: the TreeArtifact
# is what consumers copy and sanitize, and Vivado's `.cache` / `.runs` /
# `.xpr` are of no use to them. The pieces of the project tree consumers
# DO need (the generated sub-IP wrappers) are merged into $BD_DIR below.
set SCRATCH_PROJECT_DIR ./project
create_project bd_project $SCRATCH_PROJECT_DIR -part $PART_NUMBER

if {[llength $IP_REPOS] > 0} {
    set_property ip_repo_paths $IP_REPOS [current_project]
    update_ip_catalog
}

foreach ci $IP_CONFIGURED_INSTANCES {
    lassign $ci ci_module_top ci_repo ci_xci_relpath
    set _xci_import_dir [file join $BD_DIR ${ci_module_top}_imported_xci]
    file mkdir $_xci_import_dir
    foreach _item [glob -nocomplain -directory $ci_repo *] {
        file copy -force $_item $_xci_import_dir/
    }
    exec chmod -R u+rwX $_xci_import_dir
    add_files -fileset sources_1 [file join $_xci_import_dir $ci_xci_relpath]
}

foreach inst $IP_INSTANCES {
    lassign $inst inst_name inst_vendor inst_library inst_version inst_module_name
    create_ip -name $inst_name -vendor $inst_vendor -library $inst_library \
        -version $inst_version -module_name $inst_module_name
}

foreach hook $PRE_HOOKS { source $hook }

# The user's BD TCL — must call `create_bd_design $MODULE_TOP` and end with
# `save_bd_design` (or `regenerate_bd_layout` then `save_bd_design`).
source $BD_SCRIPT

set bd_files [get_files -quiet "${MODULE_TOP}.bd"]
if {[llength $bd_files] == 0} {
    error "Block design '$MODULE_TOP' was not created by $BD_SCRIPT. Check that the TCL calls `create_bd_design \"$MODULE_TOP\"`."
}
set bd_file [lindex $bd_files 0]
set bd_src_dir [file dirname $bd_file]

# `synth_checkpoint_mode NONE` + `{synthesis implementation}` (not `all` —
# `all` emits sim artifacts like BFMs and encrypted monitor models that
# pollute the downstream synth source set).
set_property synth_checkpoint_mode NONE $bd_file
generate_target {synthesis implementation} $bd_file

# `file copy -force` overwrites a destination FILE but ERRORS when the
# destination is a same-named DIRECTORY, and `file delete -force` on the
# destination first would turn every copy into a top-level REPLACE —
# wiping whatever an earlier pass already put in `hdl/` or `ip/`. Recurse
# instead: same-named directories merge, only leaf files are overwritten.
proc rules_vivado_merge_tree {src dest} {
    if {[file isdirectory $src] && [file isdirectory $dest]} {
        foreach item [glob -nocomplain -directory $src *] {
            rules_vivado_merge_tree $item [file join $dest [file tail $item]]
        }
        return
    }
    file delete -force $dest
    file copy -force $src $dest
}

foreach item [glob -nocomplain -directory $bd_src_dir *] {
    rules_vivado_merge_tree $item [file join $BD_DIR [file tail $item]]
}

# Merge the generated gen tree back into BD_DIR so consumers find the sub-IP
# synth wrappers (`<bd_dir>/ip/<sub_ip>/synth/<sub_ip>.v`). Without this,
# downstream `synth_design` elaborates the BD wrapper but fails with
# `[Synth 8-439] module '<bd>_<sub_ip>_0' not found`. Vivado's default
# layout is `<proj>.gen/sources_1/bd/<module_top>/...` under the scratch
# project dir.
set _bd_gen_dir [file join $SCRATCH_PROJECT_DIR bd_project.gen sources_1 bd $MODULE_TOP]
if {[file isdirectory $_bd_gen_dir]} {
    foreach item [glob -nocomplain -directory $_bd_gen_dir *] {
        # A BD shipping static sub-IPs in `ip/` collides with
        # `generate_target`'s own `ip/` output here, and the srcs-tree copy
        # above has already populated `hdl/` — so this has to be a real
        # per-file merge, not a directory replace.
        rules_vivado_merge_tree $item [file join $BD_DIR [file tail $item]]
    }
}

foreach hook $POST_HOOKS { source $hook }

close_project
